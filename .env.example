# Copy to .env for local dev and fill in real values. Never commit the real .env.

# Local only. On Render this comes from the service port binding (leave unset there).
PORT=5000

# Pins the mode for a deployment, AUTHORITATIVELY. When set, the x-partner-mode
# header cannot override it — a sandbox URL is always test, a live URL always live.
#   - developer "live" service    -> PARTNER_MODE=live
#   - developer "sandbox" service -> PARTNER_MODE=test
#   - dashboard service           -> leave UNSET (the dashboard toggle drives mode)
# Leave UNSET locally too (defaults to host-based detection, then live).
# PARTNER_MODE=live

# Shared across BOTH live and sandbox services — they use ONE database because
# each partner's live and test keys live in the same Partner document.
MONGO_URI=your_mongodb_connection_string
ALLOWED_ORIGINS=http://localhost:5173

# Partner dashboard auth (partner login tokens) — independent of the main API's JWT.
JWT_SECRET=generate_with_node_-e_crypto.randomBytes(48).toString('hex')

# Main Send API connection.
SEND_API_BASE_URL=https://send-api-1v9v.onrender.com/api/v1
# Shared with the main API (must be identical there) — authenticates partner -> platform calls.
SEND_API_PARTNER_SECRET=generate_with_node_-e_crypto.randomBytes(64).toString('hex')
# Shared with the main API (must be identical there) — for the admin proxy.
PARTNER_ADMIN_SECRET=generate_with_node_-e_crypto.randomBytes(32).toString('hex')

# AES-256-GCM key for encrypting partner API keys/secrets at rest (64 hex chars = 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DO NOT change once partners have keys, or they become unrecoverable.
API_ENCRYPTION_KEY=64_hex_characters
